---
interface Props { name: string; description: string; icon: string; href: string }
const { name, description, icon, href } = Astro.props;
---
<article class="app-card">
  <img src={icon} alt={`${name} app icon`} width="80" height="80" loading="lazy" />
  <p class="eyebrow">Coming 2027</p>
  <h3>{name}</h3>
  <p>{description}</p>
  <a class="content-link" href={href} aria-label={`Learn more about ${name}`}>Learn more <span aria-hidden="true">→</span></a>
</article>
