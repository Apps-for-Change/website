---
import AppCard from './AppCard.astro';
import apps from '../data/apps.json';
---
<section id="apps" class="apps-section">
  <h2>Four apps. One goal: helping you thrive.</h2>
  <p class="section-intro">Each app focuses on a different part of a good life. Use one, or use all four. They're free either way.</p>
  <div class="app-grid">{apps.map(app => <AppCard {...app} />)}</div>
</section>
