---
import AppGrid from './AppGrid.astro';
import DonateSection from './DonateSection.astro';
import CrisisBox from './CrisisBox.astro';
interface Block { type: string; items?: string[]; text?: string; href?: string; question?: string; headers?: string[]; rows?: string[][] }
interface Props { sections: { heading: string; blocks: Block[] }[] }
const { sections } = Astro.props;
---
{sections.map(section => <section class="content-section">
  {section.heading && <h2>{section.heading}</h2>}
  {section.blocks.map(block => <>
    {block.type === 'p' && <p>{block.text}</p>}
    {block.type === 'list' && <ul>{block.items?.map(item => <li>{item}</li>)}</ul>}
    {block.type === 'link' && <p><a class="content-link" href={block.href}>{block.text} <span aria-hidden="true">→</span></a></p>}
    {block.type === 'faq-link' && <details><summary>{block.question}</summary><p><a class="content-link" href={block.href}>{block.text} →</a></p></details>}
    {block.type === 'faq' && <details><summary>{block.question}</summary><p>{block.text}</p></details>}
    {block.type === 'table' && <div class="table-scroll" tabindex="0" role="region" aria-label={section.heading}><table><caption class="sr-only">{section.heading}</caption><thead><tr>{block.headers?.map(h => <th scope="col">{h}</th>)}</tr></thead><tbody>{block.rows?.map(row => <tr>{row.map(cell => <td>{cell}</td>)}</tr>)}</tbody></table></div>}
    {block.type === 'apps' && <AppGrid />}
    {block.type === 'donate' && <DonateSection />}
    {block.type === 'crisis' && <CrisisBox />}
  </>)}
</section>)}
