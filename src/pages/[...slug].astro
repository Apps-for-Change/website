---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ContentSections from '../components/ContentSections.astro';
import pages from '../data/content.json';
import apps from '../data/apps.json';
export function getStaticPaths() {
  return pages.filter(page => page.slug).map(page => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props;
const app = apps.find(app => app.href === '/' + page.slug);
---
<BaseLayout title={page.title} description={page.description || `${app?.name}: a free, private app from Apps for Change, coming in 2027.`}>
  <Navbar />
  <main id="main-content" class="page-content">
    <header class="page-heading">
      {app && <img src={app.icon} alt={`${app.name} app icon`} width="96" height="96" class="app-detail-icon" />}
      {page.label && <p class="eyebrow">{page.label}</p>}
      <h1>{page.headline}</h1>
      {page.body && <p class="lead">{page.body}</p>}
    </header>
    <ContentSections sections={page.sections} />
  </main>
  <Footer />
</BaseLayout>
